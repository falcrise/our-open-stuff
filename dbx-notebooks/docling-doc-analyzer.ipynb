import json
import uuid
from pathlib import Path
from typing import Any, Dict, List, Optional

import pandas as pd
from docling.document_converter import DocumentConverter

# robust way to get the installed package version
try:
    from importlib.metadata import version, PackageNotFoundError
except ImportError:  # Python <3.8, but Databricks is usually 3.8+
    from importlib_metadata import version, PackageNotFoundError

try:
    DOCLING_VERSION = version("docling")
except PackageNotFoundError:
    DOCLING_VERSION = None


    # COMMAND ----------
def df_to_rows(df: pd.DataFrame) -> List[Dict[str, Any]]:
    """
    Convert a pandas DataFrame into a list of row objects with:
      {
        "rowIndex": int,
        "cells": { columnName: cellValue }
      }
    """
    rows = []
    records = df.to_dict(orient="records")
    for idx, rec in enumerate(records):
        rows.append(
            {
                "rowIndex": idx,
                "cells": {str(col): ("" if pd.isna(val) else str(val)) for col, val in rec.items()},
            }
        )
    return rows


def build_salesforce_schema(
    source_path: str,
    docling_doc,
    extracted_fields: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    """
    Build a single, stable JSON schema for Salesforce ingestion.

    Structure:
    - documentId
    - sourcePath
    - metadata
    - content.textSections[]
    - content.tables[]
    - extractedFields (for key financial fields, if/when you add those rules)
    """
    extracted_fields = extracted_fields or {}

    # Basic metadata (Docling has metadata in its document datamodel; we keep it simple here). :contentReference[oaicite:2]{index=2}
    metadata = {
        "title": getattr(docling_doc, "title", None),
        "author": getattr(docling_doc, "author", None),
        "numPages": len(getattr(docling_doc, "pages", []) or []),
        "doclingVersion": DOCLING_VERSION,
    }

    # ---- Text sections ----
    # DoclingDocument exposes blocks / sections; here we fall back to pages if needed.
    text_sections = []
    section_counter = 0

    pages = getattr(docling_doc, "pages", []) or []
    for page_idx, page in enumerate(pages, start=1):
        # `blocks` or `items` naming may differ slightly by version;
        # we handle both patterns defensively.
        blocks = getattr(page, "blocks", None) or getattr(page, "items", []) or []
        for block in blocks:
            text = getattr(block, "text", "").strip()
            if not text:
                continue

            heading_path = []
            # If block has heading properties, attach them as hierarchy.
            # (You can later map this to Salesforce sections / related records.)
            if hasattr(block, "category") and getattr(block, "category") == "title":
                heading_path = [text]

            section_counter += 1
            text_sections.append(
                {
                    "sectionId": f"sec-{section_counter}",
                    "page": page_idx,
                    "headingPath": heading_path,
                    "text": text,
                }
            )

    # ---- Tables ----
    tables_json = []
    tables = getattr(docling_doc, "tables", []) or []

    for idx, table in enumerate(tables, start=1):
        # Docling can export tables directly to pandas DataFrames. :contentReference[oaicite:3]{index=3}
        try:
            df = table.export_to_dataframe(doc=docling_doc)
        except TypeError:
            # older versions may not require doc=
            df = table.export_to_dataframe()

        cols = [str(c) for c in df.columns]
        rows = df_to_rows(df)

        # Page number & caption, if available
        prov = getattr(table, "prov", [])
        page_no = prov[0].page_no if prov else None

        caption_text = None
        if hasattr(table, "caption_text"):
            try:
                caption_text = table.caption_text(docling_doc)
            except TypeError:
                # some versions treat caption_text as property
                caption_text = table.caption_text

        tables_json.append(
            {
                "tableId": f"tbl-{idx}",
                "page": page_no,
                "caption": caption_text,
                "columns": cols,
                "rows": rows,
            }
        )

    return {
        "documentId": Path(source_path).name or str(uuid.uuid4()),
        "sourcePath": source_path,
        "metadata": metadata,
        "content": {
            "textSections": text_sections,
            "tables": tables_json,
        },
        "extractedFields": extracted_fields,
    }


# COMMAND ----------
def parse_document_to_salesforce_json(source_path: str) -> Dict[str, Any]:
    """
    Parse a financial document with Docling and return a Salesforce-ready JSON
    schema (nested dict).

    `source_path` can be:
    - A local/DBFS path in Databricks (e.g. "/dbfs/FileStore/financial_docs/audit.pdf")
    - A URL to a PDF/Docx, etc.
    """
    converter = DocumentConverter()  # Docling core converter :contentReference[oaicite:4]{index=4}
    result = converter.convert(source_path)
    doc = result.document if hasattr(result, "document") else result

    # TODO: Implement domain-specific extraction later (invoice no, totals, etc.)
    extracted_fields = {}

    sf_json = build_salesforce_schema(source_path=source_path, docling_doc=doc, extracted_fields=extracted_fields)
    return sf_json


# Example: parse a single PDF and view JSON

input_doc_path = "/Workspace/bfsi/bfsiDoc.pdf"

sf_json = parse_document_to_salesforce_json(input_doc_path)

print(json.dumps(sf_json, indent=2, ensure_ascii=False))
